<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Parallelism comes from the scenarios DataProvider; its thread count is set at runtime
     from the "threads" config key by ParallelismListener. -->
<suite name="E2E Suite" verbose="1">
  <listeners>
    <listener class-name="com.example.e2e.runners.ParallelismListener"/>
  </listeners>
  <test name="Cucumber scenarios">
    <classes>
      <class name="com.example.e2e.runners.CucumberTestRunner"/>
    </classes>
  </test>
</suite>
